{
  "name": "cybersave-backend",
  "version": "1.0.0",
  "scripts": {
    "dev:gateway": "npm --prefix gateway run dev",
    "dev:core": "npm --prefix services/core-service run dev",
    "dev:ops": "npm --prefix services/ops-service run dev",
    "dev": "concurrently --kill-others -n gateway,core,ops -c \"bgBlue.bold,bgMagenta.bold,bgGreen.bold\" \"npm run dev:gateway\" \"npm run dev:core\" \"npm run dev:ops\"",
    "build": "tsc",
    "start:monolith": "node dist/monolith.js",
    "dev:monolith": "ts-node-dev --respawn --transpile-only monolith.ts"
  },
  "dependencies": {
    "@cybersave/shared": "file:./shared",
    "@supabase/supabase-js": "^2.43.0",
    "@upstash/redis": "^1.38.2",
    "axios": "^1.19.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.0",
    "express": "^4.19.2",
    "express-rate-limit": "^7.3.0",
    "helmet": "^7.1.0",
    "ioredis": "^5.4.0",
    "jsonwebtoken": "^9.0.0",
    "mongoose": "^8.4.0",
    "razorpay": "^2.9.0",
    "ts-node": "^10.9.2",
    "uuid": "^14.0.1",
    "winston": "^3.13.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/node": "^20.14.0",
    "@types/uuid": "^11.0.0",
    "concurrently": "^8.2.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.4.0"
  }
}
